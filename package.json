{
  "name": "pelagic",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:cloudflare": "node scripts/generate-cloudflare-metadata.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api": "node server/index.mjs",
    "ingest": "node scripts/ingest-papers.ts",
    "test": "node --test server/rag.test.mjs scripts/screening.test.mjs scripts/metadata.test.mjs cloudflare/cloudflare.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "4.144.0"
  }
}
