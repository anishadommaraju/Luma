{
  "name": "ocd-project",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
